DEBUG=True
SECRET_KEY=1234
WEBHOOK_SECRET=change-me
# Postgres connection string on Render, e.g. postgresql://user:pass@host:5432/dbname
# Leave unset locally to fall back to SQLite.
DATABASE_URL=
# Comma-separated, e.g. your-app.onrender.com
ALLOWED_HOSTS=*
# Comma-separated, e.g. https://your-app.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app,https://*.onrender.com
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=
DEFAULT_FROM_EMAIL=
# SendGrid API key (https://app.sendgrid.com/settings/api_keys). If set, it overrides EMAIL_HOST*.
# DEFAULT_FROM_EMAIL must be a verified sender in SendGrid.
SENDGRID_API_KEY=
